# Environment variables for ClaimYourTrip.com
# Copy this file to .env.local and fill in real values. Never commit .env.local.

# Brevo (email marketing + transactional delivery email) API key — used by
# api/subscribe.js and api/_brevo.js
# Get from: https://app.brevo.com → Profile → SMTP & API → API Keys
BREVO_API_KEY=your-brevo-api-key-here

# --- PayPal + private digital-delivery (Claim Pack) ---
# Fail-closed sales gate. Must be the exact string "true" to enable
# purchases; anything else (including unset) disables the buy flow.
CLAIM_PACK_SALES_ENABLED=false

# PayPal REST app credentials. Use SANDBOX values for local/Preview — this
# phase never calls PayPal's live endpoints regardless of this value (see
# resolvePayPalEnvironment() in api/paypal/_paypal-client.js, hard-clamped
# to sandbox outside VERCEL_ENV=production).
PAYPAL_ENV=sandbox
# Public, not secret — this is the same client ID PayPal's own SDK exposes
# in the browser for a standard one-time Payments integration (no Fastlane).
# Served to the browser as-is via GET /api/paypal/config.
PAYPAL_CLIENT_ID=your-sandbox-client-id
PAYPAL_CLIENT_SECRET=your-sandbox-client-secret
# Expected receiving merchant ID — capture validation rejects any payment
# not paid to this exact merchant, even if amount/currency/SKU all match.
PAYPAL_MERCHANT_ID=your-sandbox-merchant-id
# From the PayPal Developer Dashboard webhook you register against this
# deployment's /api/paypal/webhook URL.
PAYPAL_WEBHOOK_ID=your-sandbox-webhook-id

# Secret used to HMAC-sign download bearer tokens. Only the token_id is
# ever stored in the database; this secret is what lets the outbox worker
# reconstruct a working link later without ever storing the raw token.
DOWNLOAD_TOKEN_SECRET=replace-with-a-long-random-value

# Required, explicit public base URL for this exact deployment — used to
# build the download link in delivery emails. Deliberately never derived
# from a request Host header (untrusted, and the outbox worker isn't even
# invoked by a browser request with a meaningful one). Must be
# https://claimyourtrip.com in Production and the deployment's own Preview
# URL in Preview — never share this value across environments.
PUBLIC_APP_BASE_URL=https://claimyourtrip.com

# Authorizes GET /api/paypal/outbox-worker. Vercel Cron sends
# "Authorization: Bearer <CRON_SECRET>" automatically once this is set;
# use a DIFFERENT value per environment (Preview vs Production) so a
# Preview secret can never authorize a Production worker run or vice versa.
CRON_SECRET=replace-with-a-long-random-value

# Neon Postgres connection string (injected automatically once a Neon
# Marketplace integration is connected to the Vercel project; only needed
# here for local development against a dev/branch database).
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# Private Vercel Blob store. Prefer OIDC (automatic once a private Blob
# store is connected to this project on Vercel) — only set
# BLOB_READ_WRITE_TOKEN as a fallback for code running outside Vercel.
# BLOB_READ_WRITE_TOKEN=your-blob-read-write-token
# The private store's internal pathname for the product ZIP. Never a public
# URL — api/download.js fetches it via @vercel/blob's authenticated get().
CLAIM_PACK_BLOB_PATHNAME=private/claim-pack-premium-v2.zip
